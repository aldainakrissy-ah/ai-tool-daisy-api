            "description": "Get all active questionnaires"
          },
          "response": []
        },
        {
          "name": "Get Questionnaire by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionnaires/gad-7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionnaires", "gad-7"]
            },
            "description": "Get a specific questionnaire by ID"
          },
          "response": []
        },
        {
          "name": "Create Questionnaire",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"questionnaireId\": \"custom-questionnaire\",\n    \"title\": {\n        \"en\": \"Custom Questionnaire\",\n        \"nl\": \"Aangepaste Vragenlijst\"\n    },\n    \"description\": {\n        \"en\": \"This is a custom questionnaire\",\n        \"nl\": \"Dit is een aangepaste vragenlijst\"\n    },\n    \"sections\": [\n        {\n            \"sectionId\": \"section-1\",\n            \"title\": {\n                \"en\": \"First Section\",\n                \"nl\": \"Eerste Sectie\"\n            },\n            \"questions\": [\n                {\n                    \"questionId\": \"q1\",\n                    \"questionType\": \"TEXT\",\n                    \"questionText\": {\n                        \"en\": \"What is your name?\",\n                        \"nl\": \"Wat is je naam?\"\n                    },\n                    \"required\": true\n                }\n            ]\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionnaires",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionnaires"]
            },
            "description": "Create a new questionnaire"
          },
          "response": []
        },
        {
          "name": "Update Questionnaire",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"questionnaireId\": \"gad-7\",\n    \"title\": {\n        \"en\": \"Updated GAD-7\",\n        \"nl\": \"Bijgewerkte GAD-7\"\n    },\n    \"description\": {\n        \"en\": \"Updated anxiety assessment\",\n        \"nl\": \"Bijgewerkte angstbeoordeling\"\n    },\n    \"sections\": [\n        {\n            \"sectionId\": \"section-1\",\n            \"title\": {\n                \"en\": \"Anxiety Assessment\",\n                \"nl\": \"Angstbeoordeling\"\n            },\n            \"questions\": [\n                {\n                    \"questionId\": \"gad7-1\",\n                    \"questionType\": \"LIKERT_SCALE\",\n                    \"questionText\": {\n                        \"en\": \"Feeling nervous, anxious, or on edge\",\n                        \"nl\": \"Nerveus, angstig of gespannen voelen\"\n                    },\n                    \"required\": true,\n                    \"options\": {\n                        \"en\": [\"Not at all\", \"Several days\", \"More than half the days\", \"Nearly every day\"],\n                        \"nl\": [\"Helemaal niet\", \"Meerdere dagen\", \"Meer dan de helft van de dagen\", \"Bijna elke dag\"]\n                    }\n                }\n            ]\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionnaires/gad-7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionnaires", "gad-7"]
            },
            "description": "Update an existing questionnaire"
          },
          "response": []
        },
        {
          "name": "Upload JSON Questionnaire",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"questionnaireId\": \"gad-7\",\n    \"title\": {\n        \"en\": \"GAD-7\",\n        \"nl\": \"GAD-7\"\n    },\n    \"description\": {\n        \"en\": \"Generalized Anxiety Disorder assessment\",\n        \"nl\": \"Gegeneraliseerde angststoornis beoordeling\"\n    },\n    \"sections\": [\n        {\n            \"sectionId\": \"section-1\",\n            \"title\": {\n                \"en\": \"Over the last 2 weeks, how often have you been bothered by the following problems?\",\n                \"nl\": \"Hoe vaak hebt u in de afgelopen 2 weken last gehad van de volgende problemen?\"\n            },\n            \"questions\": [\n                {\n                    \"questionId\": \"gad7-1\",\n                    \"questionType\": \"LIKERT_SCALE\",\n                    \"questionText\": {\n                        \"en\": \"Feeling nervous, anxious, or on edge\",\n                        \"nl\": \"Nerveus, angstig of gespannen voelen\"\n                    },\n                    \"required\": true,\n                    \"options\": {\n                        \"en\": [\"Not at all\", \"Several days\", \"More than half the days\", \"Nearly every day\"],\n                        \"nl\": [\"Helemaal niet\", \"Meerdere dagen\", \"Meer dan de helft van de dagen\", \"Bijna elke dag\"]\n                    }\n                }\n            ]\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionnaires/gad-7/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionnaires", "gad-7", "upload"]
            },
            "description": "Update a questionnaire by uploading JSON"
          },
          "response": []
        },
        {
          "name": "Delete Questionnaire",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionnaires/gad-7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionnaires", "gad-7"]
            },
            "description": "Delete a questionnaire by ID"
          },
          "response": []
        },
        {
          "name": "Load Questionnaire from JSON",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionnaires/load/gad-7.json",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionnaires", "load", "gad-7.json"]
            },
            "description": "Load a specific questionnaire from JSON file"
          },
          "response": []
        },
        {
          "name": "Load All Questionnaires",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionnaires/load-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionnaires", "load-all"]
            },
            "description": "Load all questionnaires from JSON files"
          },
          "response": []
        }
