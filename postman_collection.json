    {
      "name": "AI Analysis",
      "item": [
        {
          "name": "Analyze Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"text\": \"Patient reports experiencing frequent headaches and fatigue for the past two weeks. No prior history of migraines.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/analyze/text",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analyze", "text"]
            },
            "description": "Analyze medical text using AI"
          },
          "response": []
        },
        {
          "name": "Analyze PDF",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/medical-document.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/analyze/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analyze", "pdf"]
            },
            "description": "Analyze medical PDF document using AI"
          },
          "response": []
        }
      ],
      "description": "Endpoints for analyzing medical text and PDFs using AI"
    },
    {
      "name": "Questionnaire Management",
      "item": [
        {
