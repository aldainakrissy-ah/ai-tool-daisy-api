    {
      "name": "Questionnaire Responses",
      "item": [
        {
          "name": "Start Questionnaire Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"questionnaireId\": \"gad-7\",\n    \"userId\": \"user123\",\n    \"languageCode\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionnaire-responses/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionnaire-responses", "start"]
            },
            "description": "Start a new questionnaire session"
          },
          "response": []
